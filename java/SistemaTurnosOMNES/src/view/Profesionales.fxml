<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ProfesionalesController"
            prefWidth="900"
            prefHeight="650">

    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="Gestión de Profesionales"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="130"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Especialidad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEspecialidad" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Matrícula:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtMatricula" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="CUIT:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCuit" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Porcentaje de Aporte:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtPorcentajeAporte" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="12">
                <Button fx:id="btnGuardar" text="Guardar" prefWidth="110" onAction="#guardarProfesional"/>
                <Button fx:id="btnModificar" text="Modificar" prefWidth="110" onAction="#modificarProfesional"/>
                <Button fx:id="btnEliminar" text="Eliminar" prefWidth="110" onAction="#eliminarProfesional"/>
                <Button fx:id="btnLimpiar" text="Limpiar" prefWidth="110" onAction="#limpiarCampos"/>
            </HBox>

            <Separator/>

            <Label text="Profesionales registrados"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <Label text="Seleccione un profesional de la tabla para modificarlo o eliminarlo."
                   style="-fx-font-style:italic; -fx-text-fill:#666666;"/>

            <TableView fx:id="tblProfesionales" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                    <TableColumn fx:id="colEspecialidad" text="Especialidad" prefWidth="180"/>
                    <TableColumn fx:id="colMatricula" text="Matrícula" prefWidth="130"/>
                    <TableColumn fx:id="colCuit" text="CUIT" prefWidth="150"/>
                    <TableColumn fx:id="colPorcentajeAporte" text="Porcentaje de Aporte" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>